<!-- ══════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════ -->
<section class="relative min-h-screen flex items-end overflow-hidden">

  <div class="absolute inset-0" style="background-image:linear-gradient(to bottom, rgba(10,18,12,0.3) 0%, rgba(10,18,12,0.1) 35%, rgba(10,18,12,0.78) 100%), url('https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?w=1800&q=80');background-size:cover;background-position:center;"></div>

  <div class="relative z-[2] w-full max-w-[820px] px-4 pb-12 sm:px-8 sm:pb-16 md:px-16 md:pb-20 lg:pb-24">

    <div class="inline-flex items-center gap-2.5 mb-6" style="color:var(--gold);font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;">
      <span class="block w-8 h-px" style="background:var(--gold);"></span>
      Mozambique · Since 2016
    </div>

    <h1 class="mb-6" style="font-family:'Playfair Display',serif;font-weight:900;font-size:clamp(36px,6.5vw,84px);line-height:1.05;color:#fff;">
      <span class="block">Building futures</span>
      <span class="block"><em style="color:var(--gold);font-style:italic;">in the heart of</em></span>
      <span class="block">Mozambique</span>
    </h1>

    <p class="mb-8 max-w-[520px]" style="font-size:clamp(15px,2vw,18px);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.82);">
      MVG Community Foundation channels proceeds from responsible gold mining into education, health, and lasting opportunity for local communities.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
      <a href="/programs"
        class="inline-block text-center px-8 py-4 rounded text-[15px] font-semibold no-underline transition-colors"
        style="background:var(--gold);color:var(--ink);letter-spacing:0.04em;"
        onmouseover="this.style.background='#E8C06A';"
        onmouseout="this.style.background='#C9973A';">
        Our Programs
      </a>
      <a href="/about"
        class="inline-block text-center px-8 py-4 rounded text-[15px] font-medium no-underline transition-all"
        style="background:none;color:#fff;border:1px solid rgba(255,255,255,0.45);letter-spacing:0.04em;"
        onmouseover="this.style.borderColor='#C9973A';this.style.color='#C9973A';"
        onmouseout="this.style.borderColor='rgba(255,255,255,0.45)';this.style.color='#fff';">
        Our Story
      </a>
    </div>
  </div>

</section>


<!-- ══════════════════════════════════════════════
     MISSION
═══════════════════════════════════════════════ -->
<section class="py-16 px-4 md:py-20 md:px-8 lg:py-[100px] lg:px-16" style="background:var(--cream);">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center max-w-[1200px] mx-auto">

    <!-- Image -->
    <div class="relative hidden lg:block">
      <div class="w-full rounded-sm" style="aspect-ratio:4/5;background-image:url('https://images.unsplash.com/photo-1594608661623-aa0bd3a69d98?w=800&q=80');background-size:cover;background-position:center;"></div>
      <div class="absolute top-8 -left-1 w-1 h-20" style="background:var(--gold);"></div>
      <div class="absolute bottom-8 -right-6 p-5 rounded-sm max-w-[220px]" style="background:var(--accent);color:#fff;box-shadow:0 8px 32px rgba(0,0,0,0.3);">
        <div class="text-[10px] font-semibold uppercase mb-1.5" style="letter-spacing:0.14em;color:var(--gold);">Gold Mining → Community</div>
        <div class="text-[13px] leading-relaxed" style="color:rgba(255,255,255,0.8);">Proceeds from responsible gold extraction in Mozambique flow directly into these programs.</div>
      </div>
    </div>

    <!-- Text -->
    <div>
      <div class="flex items-center mb-5" style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);">
        <span class="inline-block w-7 h-px mr-2.5" style="background:var(--gold);"></span>
        Our Mission
      </div>
      <h2 class="mb-7" style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,52px);font-weight:700;line-height:1.15;color:var(--ink);">From the mine to the community</h2>
      <p class="mb-5" style="font-size:17px;line-height:1.75;color:var(--muted);">
        MVG Community Foundation was established to ensure that the wealth generated from Mozambique's natural resources flows directly back to the people who live alongside it.
      </p>
      <p class="mb-8" style="font-size:17px;line-height:1.75;color:var(--muted);">
        Every dollar raised is reinvested in programs that create measurable, lasting change — one family at a time.
      </p>
      <blockquote class="m-0 p-6 md:p-7" style="border-left:3px solid var(--gold);background:rgba(201,151,58,0.06);font-family:'Playfair Display',serif;font-style:italic;font-size:clamp(16px,2vw,18px);color:var(--ink);line-height:1.6;">
        "We believe every person deserves access to the resources they need to thrive."
      </blockquote>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     PROGRAMS PREVIEW
═══════════════════════════════════════════════ -->
<section class="py-16 px-4 md:py-20 md:px-8 lg:py-[100px] lg:px-16" style="background:#FDFAF5;">
  <div class="max-w-[1200px] mx-auto">

    <div class="flex items-center mb-5" style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);">
      <span class="inline-block w-7 h-px mr-2.5" style="background:var(--gold);"></span>
      What We Do
    </div>

    <h2 class="max-w-[480px] mb-12" style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,52px);font-weight:700;line-height:1.15;color:var(--ink);">Programs that transform lives</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[2px]">
      <% const programs = [
        { icon:'<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',                                                     title:'Education & Tutoring',  body:'Free after-school tutoring, college prep workshops, and scholarship opportunities for students from low-income households.' },
        { icon:'<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',        title:'Food Security',          body:'Weekly food distributions, community gardens, and partnerships with local food banks to ensure no family goes hungry.' },
        { icon:'<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',                                                                                                               title:'Health & Wellness',      body:'Free health screenings, mental health resources, and referrals to affordable care for uninsured community members.' },
        { icon:'<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',                                                   title:'Job Readiness',          body:'Resume workshops, interview coaching, and connections to local employers for adults seeking stable employment.' },
        { icon:'<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',                                                                             title:'Youth Leadership',       body:'Mentorship programs, civic engagement training, and leadership retreats to develop the next generation.' },
        { icon:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',  title:'Senior Support',         body:'Transportation assistance, meal delivery, and social activities for elderly residents who may be isolated.' },
      ]; %>
      <% programs.forEach(p => { %>
        <div
          class="p-8 md:p-10 cursor-default transition-all duration-200"
          style="background:var(--cream);border-top:3px solid var(--gold);"
          onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 40px rgba(0,0,0,0.08)';"
          onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='none';">
          <div class="mb-6">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><%- p.icon %></svg>
          </div>
          <h3 class="mb-3 leading-snug" style="font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--ink);"><%= p.title %></h3>
          <p class="text-sm leading-7" style="color:var(--muted);"><%= p.body %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>


