<!DOCTYPE html>
<html lang="<%= locals.lang === 'ua' ? 'uk' : 'en' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | MVG Community Foundation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink:      '#0F1A14',
            accent:   '#1C3D2A',
            gold:     '#C9973A',
            'gold-lt':'#E8C06A',
            cream:    '#F2ECE0',
            muted:    '#6B7B6E',
          },
          fontFamily: {
            serif: ["'Playfair Display'", 'Georgia', 'serif'],
            sans:  ["'DM Sans'", 'sans-serif'],
          },
        }
      }
    };
  </script>
  <style>
    :root {
      --ink:    #0F1A14;
      --bg:     #FDFAF5;
      --accent: #1C3D2A;
      --gold:   #C9973A;
      --gold-lt:#E8C06A;
      --cream:  #F2ECE0;
      --muted:  #6B7B6E;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: #FDFAF5; color: #0F1A14; overflow-x: hidden; }

    #navbar { transition: background 0.4s, box-shadow 0.4s; }
    #navbar.nav-dark {
      background: rgba(15,26,20,0.97) !important;
      backdrop-filter: blur(14px);
      box-shadow: 0 1px 0 rgba(201,151,58,0.18);
    }
    #mobile-menu { backdrop-filter: blur(14px); }

    @keyframes scrollPulse {
      0%,100% { opacity: 0.5; }
      50%      { opacity: 1; }
    }
  </style>
</head>
<body>
<%
  const isUa = locals.lang === 'ua';
  const navItems = isUa
    ? [['/ua','Головна'],['/ua/about','Про нас'],['/ua/programs','Програми'],['/ua/donate','Пожертвувати'],['/ua/contact','Контакти']]
    : [['/', 'Home'],['/about','About'],['/programs','Programs'],['/donate','Donate'],['/contact','Contact']];
%>

  <!-- ── NAVBAR ── -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-[200] h-[68px] flex items-center justify-between px-4 md:px-12" style="background:transparent;">

    <!-- Logo -->
    <a href="<%= isUa ? '/ua' : '/' %>" class="flex items-center shrink-0" style="font-family:'Playfair Display',serif;font-size:clamp(14px,2.5vw,18px);font-weight:700;color:#fff;letter-spacing:0.02em;text-decoration:none;">
      MVG<span style="color:var(--gold);">&nbsp;Community</span><span class="hidden sm:inline" style="color:rgba(255,255,255,0.5);font-weight:300;">&nbsp;Foundation</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden md:flex items-center gap-6 list-none">
      <% navItems.forEach(([href, label]) => { %>
        <li>
          <a href="<%= href %>"
            style="color:rgba(255,255,255,0.8);text-decoration:none;font-size:14px;font-weight:500;letter-spacing:0.04em;transition:color 0.2s;border-bottom:1px solid transparent;padding-bottom:2px;"
            onmouseover="this.style.color='#C9973A';this.style.borderBottomColor='#C9973A';"
            onmouseout="this.style.color='rgba(255,255,255,0.8)';this.style.borderBottomColor='transparent';">
            <%= label %>
          </a>
        </li>
      <% }) %>
    </ul>

    <!-- Desktop right: lang switcher + donate btn -->
    <div class="hidden md:flex items-center gap-3.5">
      <div class="flex gap-[2px] rounded-[20px] p-[3px]" style="background:rgba(255,255,255,0.1);">
        <a href="<%= locals.enUrl || '/' %>"
          class="text-xs font-semibold px-[10px] py-1 rounded-[16px] uppercase tracking-widest no-underline transition-all"
          style="background:<%= isUa ? 'none' : 'var(--gold)' %>;color:<%= isUa ? 'rgba(255,255,255,0.6)' : '#0F1A14' %>;">EN</a>
        <a href="<%= locals.uaUrl || '/ua' %>"
          class="text-xs font-semibold px-[10px] py-1 rounded-[16px] uppercase tracking-widest no-underline transition-all"
          style="background:<%= isUa ? 'var(--gold)' : 'none' %>;color:<%= isUa ? '#0F1A14' : 'rgba(255,255,255,0.6)' %>;">UA</a>
      </div>
      <a href="<%= isUa ? '/ua/donate' : '/donate' %>"
        class="text-[13px] font-semibold px-5 py-2.5 rounded no-underline transition-colors"
        style="background:var(--gold);color:var(--ink);letter-spacing:0.04em;"
        onmouseover="this.style.background='#E8C06A';"
        onmouseout="this.style.background='#C9973A';">
        <%= isUa ? 'Пожертвувати' : 'Donate Now' %>
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button id="menu-btn" class="md:hidden text-white p-2 -mr-1 cursor-pointer border-0 bg-transparent" onclick="toggleMobileMenu()" aria-label="Toggle menu">
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile dropdown menu -->
  <div id="mobile-menu" class="hidden fixed top-[68px] left-0 right-0 z-[199] flex-col p-6 gap-1 md:hidden" style="background:rgba(15,26,20,0.97);">
    <% navItems.forEach(([href, label]) => { %>
      <a href="<%= href %>" class="block py-3 no-underline text-base font-medium" style="color:rgba(255,255,255,0.85);border-bottom:1px solid rgba(255,255,255,0.06);"
        onmouseover="this.style.color='#C9973A';"
        onmouseout="this.style.color='rgba(255,255,255,0.85)';">
        <%= label %>
      </a>
    <% }) %>
    <div class="flex items-center justify-between pt-4 mt-2">
      <div class="flex gap-[2px] rounded-[20px] p-[3px]" style="background:rgba(255,255,255,0.1);">
        <a href="<%= locals.enUrl || '/' %>"
          class="text-xs font-semibold px-[10px] py-1 rounded-[16px] uppercase tracking-widest no-underline"
          style="background:<%= isUa ? 'none' : 'var(--gold)' %>;color:<%= isUa ? 'rgba(255,255,255,0.6)' : '#0F1A14' %>;">EN</a>
        <a href="<%= locals.uaUrl || '/ua' %>"
          class="text-xs font-semibold px-[10px] py-1 rounded-[16px] uppercase tracking-widest no-underline"
          style="background:<%= isUa ? 'var(--gold)' : 'none' %>;color:<%= isUa ? '#0F1A14' : 'rgba(255,255,255,0.6)' %>;">UA</a>
      </div>
      <a href="<%= isUa ? '/ua/donate' : '/donate' %>"
        class="text-sm font-bold px-5 py-2.5 rounded no-underline"
        style="background:var(--gold);color:var(--ink);">
        <%= isUa ? 'Пожертвувати' : 'Donate Now' %>
      </a>
    </div>
  </div>

  <!-- ── CONTENT ── -->
  <main><%- body %></main>

  <!-- ── FOOTER ── -->
  <footer class="px-4 pt-12 pb-8 md:px-16 md:pt-16 md:pb-10" style="background:var(--ink);">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex flex-col gap-8 pb-8 md:flex-row md:justify-between md:items-start" style="border-bottom:1px solid rgba(255,255,255,0.08);">
        <div>
          <div class="mb-3" style="font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:#fff;">
            MVG <span style="color:var(--gold);">Community</span> Foundation
          </div>
          <p class="text-sm max-w-[280px] leading-relaxed" style="color:rgba(255,255,255,0.4);">
            <%= isUa ? 'Перетворюємо золото на можливості — для кожної громади.' : 'Channeling gold into opportunity, one community at a time.' %>
          </p>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-3">
          <% navItems.forEach(([href, label]) => { %>
            <a href="<%= href %>" class="text-[13px] font-medium no-underline transition-colors" style="color:rgba(255,255,255,0.5);"
              onmouseover="this.style.color='#C9973A';"
              onmouseout="this.style.color='rgba(255,255,255,0.5)';">
              <%= label %>
            </a>
          <% }) %>
        </div>
      </div>
      <div class="pt-5 flex flex-col gap-1 sm:flex-row sm:justify-between sm:items-center">
        <p class="text-[13px]" style="color:rgba(255,255,255,0.25);">
          &copy; <%= new Date().getFullYear() %> MVG Community Foundation.
          <%= isUa ? 'Усі права захищені.' : 'All rights reserved.' %>
        </p>
        <p class="text-xs" style="color:rgba(255,255,255,0.2);">Mozambique · Africa</p>
      </div>
    </div>
  </footer>

  <script>
    const navbar = document.getElementById('navbar');
    <% if (locals.page !== 'home') { %>
    navbar.classList.add('nav-dark');
    <% } else { %>
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('nav-dark', window.scrollY > 40);
    });
    <% } %>

    function toggleMobileMenu() {
      const menu    = document.getElementById('mobile-menu');
      const iconOpen  = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      const isOpen  = menu.classList.contains('flex');
      menu.classList.toggle('hidden', isOpen);
      menu.classList.toggle('flex', !isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
    }
  </script>
</body>
</html>
