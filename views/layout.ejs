<!DOCTYPE html>
<html lang="<%= locals.lang === 'ua' ? 'uk' : 'en' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | MVG Community Foundation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink:      '#0F1A14',
            accent:   '#1C3D2A',
            gold:     '#C9973A',
            'gold-lt':'#E8C06A',
            cream:    '#F2ECE0',
            muted:    '#6B7B6E',
          },
          fontFamily: {
            serif: ["'Playfair Display'", 'Georgia', 'serif'],
            sans:  ["'DM Sans'", 'sans-serif'],
          },
        }
      }
    };
  </script>
  <style>
    :root {
      --ink:    #0F1A14;
      --bg:     #FDFAF5;
      --accent: #1C3D2A;
      --gold:   #C9973A;
      --gold-lt:#E8C06A;
      --cream:  #F2ECE0;
      --muted:  #6B7B6E;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: #FDFAF5; color: #0F1A14; overflow-x: hidden; }

    #navbar { transition: background 0.4s, box-shadow 0.4s; }
    #navbar.nav-dark {
      background: rgba(15,26,20,0.97) !important;
      backdrop-filter: blur(14px);
      box-shadow: 0 1px 0 rgba(201,151,58,0.18);
    }
    #mobile-menu { backdrop-filter: blur(14px); }

    @keyframes scrollPulse {
      0%,100% { opacity: 0.5; }
      50%      { opacity: 1; }
    }

    /* ── Chat Widget ──────────────────────────────────── */
    #chat-toggle {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 9999;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--gold);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(201,151,58,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    #chat-toggle:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(201,151,58,0.55); }

    #chat-box {
      position: fixed;
      bottom: 96px;
      right: 28px;
      z-index: 9998;
      width: 340px;
      display: flex;
      flex-direction: column;
      border-radius: 16px;
      background: rgba(12,22,16,0.95);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(201,151,58,0.22);
      box-shadow: 0 12px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04);
      overflow: hidden;
      transform: translateY(12px) scale(0.97);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.28s cubic-bezier(.4,0,.2,1), opacity 0.28s;
    }
    #chat-box.chat-open {
      transform: translateY(0) scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    #chat-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid rgba(201,151,58,0.15);
      flex-shrink: 0;
    }
    .chat-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      letter-spacing: 0.04em;
    }
    .chat-status {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: rgba(255,255,255,0.4);
      margin-top: 2px;
    }
    .chat-status::before {
      content: '';
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #4ade80;
      flex-shrink: 0;
    }
    #chat-close {
      background: none;
      border: none;
      cursor: pointer;
      color: rgba(255,255,255,0.4);
      font-size: 18px;
      line-height: 1;
      padding: 4px 6px;
      border-radius: 6px;
      transition: color 0.15s, background 0.15s;
    }
    #chat-close:hover { color: #fff; background: rgba(255,255,255,0.08); }

    #chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 14px 14px 8px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 220px;
      max-height: 290px;
      scrollbar-width: thin;
      scrollbar-color: rgba(201,151,58,0.2) transparent;
    }
    #chat-messages::-webkit-scrollbar { width: 4px; }
    #chat-messages::-webkit-scrollbar-track { background: transparent; }
    #chat-messages::-webkit-scrollbar-thumb { background: rgba(201,151,58,0.2); border-radius: 4px; }

    .chat-msg { display: flex; }
    .chat-msg.msg-out { justify-content: flex-end; }
    .chat-msg.msg-in  { justify-content: flex-start; }
    .msg-bubble {
      max-width: 80%;
      padding: 8px 12px;
      border-radius: 12px;
      font-size: 13px;
      line-height: 1.5;
      word-break: break-word;
      font-family: 'DM Sans', sans-serif;
    }
    .msg-out .msg-bubble {
      background: var(--gold);
      color: var(--ink);
      border-bottom-right-radius: 4px;
    }
    .msg-in .msg-bubble {
      background: rgba(255,255,255,0.07);
      color: rgba(255,255,255,0.88);
      border: 1px solid rgba(255,255,255,0.08);
      border-bottom-left-radius: 4px;
    }
    .chat-empty {
      text-align: center;
      font-size: 12px;
      color: rgba(255,255,255,0.25);
      margin: auto;
      padding: 20px 8px;
      font-family: 'DM Sans', sans-serif;
    }

    #chat-input-area {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-top: 1px solid rgba(255,255,255,0.06);
      flex-shrink: 0;
    }
    #chat-input {
      flex: 1;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 13px;
      color: #fff;
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.2s;
    }
    #chat-input::placeholder { color: rgba(255,255,255,0.3); }
    #chat-input:focus { border-color: rgba(201,151,58,0.5); }
    #chat-input:disabled { opacity: 0.5; }
    #chat-send {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: var(--gold);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.15s;
    }
    #chat-send:hover { background: var(--gold-lt); }
    #chat-send:disabled { opacity: 0.5; cursor: not-allowed; }

    @media (max-width: 480px) {
      #chat-box {
        width: calc(100vw - 32px);
        right: 16px;
        bottom: 88px;
      }
      #chat-toggle {
        right: 16px;
        bottom: 20px;
      }
    }
  </style>
</head>
<body>

