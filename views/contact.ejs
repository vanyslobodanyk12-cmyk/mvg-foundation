<section style="background:#FDFAF5;padding:120px 64px 100px;">
  <div style="max-width:1100px;margin:0 auto;">

    <div style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;margin-bottom:20px;">
      <span style="display:inline-block;width:28px;height:1px;background:var(--gold);margin-right:10px;"></span>
      Get in Touch
    </div>

    <h1 style="font-family:'Playfair Display',serif;font-size:clamp(38px,5vw,68px);font-weight:900;line-height:1.08;color:var(--ink);margin-bottom:16px;">Contact us</h1>
    <p style="font-size:17px;color:var(--muted);line-height:1.75;max-width:520px;margin-bottom:64px;">
      Have a question, want to volunteer, or looking to partner with us? We'd love to hear from you.
    </p>

    <div style="display:grid;grid-template-columns:3fr 2fr;gap:2px;">

      <!-- Form -->
      <div style="background:var(--cream);padding:48px;">
        <% [['Name','Your name','text'],['Email','your@email.com','email'],['Subject','How can we help?','text']].forEach(([label,ph,type]) => { %>
          <div style="margin-bottom:20px;">
            <label style="display:block;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;"><%= label %></label>
            <input type="<%= type %>" placeholder="<%= ph %>"
              style="width:100%;background:#fff;border:1px solid rgba(0,0,0,0.12);border-radius:4px;padding:12px 16px;font-size:15px;font-family:'DM Sans',sans-serif;color:var(--ink);outline:none;" />
          </div>
        <% }) %>
        <div style="margin-bottom:28px;">
          <label style="display:block;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">Message</label>
          <textarea rows="5"
            style="width:100%;background:#fff;border:1px solid rgba(0,0,0,0.12);border-radius:4px;padding:12px 16px;font-size:15px;font-family:'DM Sans',sans-serif;color:var(--ink);outline:none;resize:vertical;"></textarea>
        </div>
        <button type="button"
          style="background:var(--accent);color:#fff;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:600;padding:16px 36px;border-radius:4px;letter-spacing:0.04em;transition:background 0.2s;"
          onmouseover="this.style.background='#2a5a3e';"
          onmouseout="this.style.background='var(--accent)';">
          Send Message
        </button>
      </div>

      <!-- Info cards -->
      <div>
        <% const info = [
          { label:'Address', value:'123 Community Drive, Suite 400\nMaputo, Mozambique' },
          { label:'Email',   value:'info@mvgfoundation.org' },
          { label:'Phone',   value:'+258 21 123 456' },
          { label:'Office Hours', value:'Mon–Fri: 9:00 AM – 5:00 PM\nSat: 10:00 AM – 2:00 PM' },
        ]; %>
        <% info.forEach((item, i) => { %>
          <div style="padding:28px 32px;background:<%= i % 2 === 0 ? 'var(--cream)' : 'rgba(201,151,58,0.06)' %>;border-left:2px solid var(--gold);margin-bottom:2px;">
            <div style="font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;"><%= item.label %></div>
            <div style="font-size:15px;color:var(--ink);line-height:1.65;white-space:pre-line;"><%= item.value %></div>
          </div>
        <% }) %>
      </div>

    </div>
  </div>
</section>
