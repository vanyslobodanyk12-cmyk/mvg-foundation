<% if (topSpacer) { %><div class="h-[68px]"></div><% } %>

<section class="py-16 px-4 md:py-20 md:px-8 lg:py-[100px] lg:px-16" style="background:var(--accent);">
  <div class="max-w-[1100px] mx-auto">

    <div class="flex items-center mb-5" style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);">
      <span class="inline-block w-7 h-px mr-2.5" style="background:var(--gold);"></span>
      Support Us
    </div>

    <h1 class="mb-4" style="font-family:'Playfair Display',serif;font-size:clamp(36px,5vw,68px);font-weight:900;line-height:1.08;color:#fff;">Make a difference today</h1>
    <p class="mb-12 max-w-[520px]" style="font-size:17px;color:rgba(255,255,255,0.65);line-height:1.7;">
      Your generosity fuels every program we run. Every dollar goes directly to serving communities in Mozambique.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-[2px] mb-[2px]">
      <% const donateTiers = [
        { value:25,  label:'Supporter', badge:null,           desc:'Provides school supplies for one child for a full semester.' },
        { value:100, label:'Champion',  badge:'Most Popular', desc:'Feeds a family of four for an entire month through our food program.' },
        { value:500, label:'Leader',    badge:null,           desc:'Sponsors a full year of mentoring for one at-risk youth.' },
      ]; %>
      <% donateTiers.forEach(function(t, i) { %>
        <div
          class="donate-tier-card p-8 md:p-10 cursor-pointer transition-all duration-200"
          onclick="selectDonatePackage(<%= i %>)"
          style="background:<%= i===1 ? 'var(--gold)' : 'rgba(255,255,255,0.06)' %>;border-top:3px solid <%= i===1 ? 'transparent' : 'rgba(201,151,58,0.25)' %>;">
          <% if (t.badge) { %>
            <div class="donate-tier-badge text-[10px] font-bold uppercase mb-2" style="letter-spacing:0.12em;color:<%= i===1 ? 'rgba(255,255,255,0.85)' : 'var(--gold)' %>;"><%= t.badge %></div>
          <% } %>
          <div class="donate-tier-amount leading-none mb-2" style="font-family:'Playfair Display',serif;font-size:clamp(36px,4vw,48px);font-weight:900;color:#fff;">$<%= t.value %></div>
          <div class="donate-tier-name text-[13px] font-semibold uppercase mb-3" style="letter-spacing:0.08em;color:<%= i===1 ? 'rgba(255,255,255,0.7)' : 'rgba(255,255,255,0.45)' %>;"><%= t.label %></div>
          <p class="donate-tier-desc text-sm leading-relaxed" style="color:<%= i===1 ? 'rgba(255,255,255,0.85)' : 'rgba(255,255,255,0.6)' %>;margin-bottom:<%= i===1 ? '24px' : '0' %>;"><%= t.desc %></p>

          <div class="donate-tier-stepper items-center justify-between pt-5" style="border-top:1px solid rgba(255,255,255,0.22);display:<%= i===1 ? 'flex' : 'none' %>;">
            <button
              onclick="adjustDonateQty(-1)"
              style="width:44px;height:44px;border:1px solid rgba(255,255,255,0.35);background:none;color:#fff;font-size:22px;line-height:1;cursor:pointer;border-radius:2px;display:flex;align-items:center;justify-content:center;font-family:'DM Sans',sans-serif;flex-shrink:0;transition:background 0.15s;"
              onmouseover="this.style.background='rgba(255,255,255,0.12)';"
              onmouseout="this.style.background='none';">−</button>
            <div style="min-width:52px;text-align:center;">
              <div class="donate-tier-qty" style="font-family:'Playfair Display',serif;font-size:30px;font-weight:700;color:#fff;line-height:1;">1</div>
            </div>
            <button
              onclick="adjustDonateQty(1)"
              style="width:44px;height:44px;border:1px solid rgba(255,255,255,0.35);background:none;color:#fff;font-size:22px;line-height:1;cursor:pointer;border-radius:2px;display:flex;align-items:center;justify-content:center;font-family:'DM Sans',sans-serif;flex-shrink:0;transition:background 0.15s;"
              onmouseover="this.style.background='rgba(255,255,255,0.12)';"
              onmouseout="this.style.background='none';">+</button>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[2px] p-6 md:p-12" style="background:rgba(255,255,255,0.04);">

      <div class="md:pr-10 pb-8 md:pb-0">
        <h3 class="mb-7" style="font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#fff;">Complete Your Donation</h3>

        <div class="mb-5">
          <label class="block text-xs font-semibold uppercase mb-2" style="letter-spacing:0.08em;color:rgba(255,255,255,0.5);">What should we call you? (optional)</label>
          <input id="donate-name" type="text" placeholder="Jane Smith"
            class="w-full rounded text-[15px] px-4 py-3 outline-none"
            style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:#fff;font-family:'DM Sans',sans-serif;" />
        </div>

        <div class="mb-7">
          <label class="block text-xs font-semibold uppercase mb-2" style="letter-spacing:0.08em;color:rgba(255,255,255,0.5);">Email (optional)</label>
          <input id="donate-email" type="email" placeholder="jane@example.com"
            class="w-full rounded text-[15px] px-4 py-3 outline-none"
            style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:#fff;font-family:'DM Sans',sans-serif;" />
        </div>

        <button id="donate-submit-btn" type="button"
          class="w-full rounded text-[15px] font-bold py-4 cursor-pointer border-0 transition-colors"
          style="background:var(--gold);color:var(--ink);font-family:'DM Sans',sans-serif;letter-spacing:0.04em;"
          onmouseover="this.style.background='#E8C06A';"
          onmouseout="this.style.background='#C9973A';"
          onclick="submitDonation()">
          Donate Now
        </button>
        <div id="donate-status" style="display:none;margin-top:14px;font-size:14px;font-family:'DM Sans',sans-serif;"></div>
      </div>

      <div class="md:pl-10 pt-8 md:pt-0 flex flex-col justify-center" style="border-top:1px solid rgba(201,151,58,0.15);">
        <div class="text-[11px] font-semibold uppercase mb-3" style="letter-spacing:0.14em;color:rgba(255,255,255,0.4);">Your Total</div>
        <div id="donate-total-amount" class="mb-3 leading-none" style="font-family:'Playfair Display',serif;font-size:48px;font-weight:900;color:var(--gold);">$100</div>
        <p id="donate-impact-lines" class="text-[14px] leading-7 mb-8" style="color:rgba(255,255,255,0.5);">1× $100</p>
        <div class="text-xs leading-relaxed" style="color:rgba(255,255,255,0.35);">🔒 Secure, encrypted payment. Tax receipt provided.</div>
      </div>

    </div>

  </div>
</section>

<script>
  var donateTierValues  = [25, 100, 500];
  var donateTierLabels  = ['Supporter', 'Champion', 'Leader'];
  var donateSelectedIdx = 1;
  var donateQty         = 1;

  function selectDonatePackage(idx) {
    if (donateSelectedIdx === idx) return;
    donateSelectedIdx = idx;
    donateQty = 1;
    renderDonateCards();
    updateDonateTotal();
  }

  function adjustDonateQty(delta) {
    donateQty = Math.max(1, donateQty + delta);
    var cards = document.querySelectorAll('.donate-tier-card');
    cards[donateSelectedIdx].querySelector('.donate-tier-qty').textContent = donateQty;
    updateDonateTotal();
  }

  function renderDonateCards() {
    document.querySelectorAll('.donate-tier-card').forEach(function(card, i) {
      var active = i === donateSelectedIdx;
      card.style.background     = active ? 'var(--gold)' : 'rgba(255,255,255,0.06)';
      card.style.borderTopColor = active ? 'transparent' : 'rgba(201,151,58,0.25)';
      card.querySelector('.donate-tier-name').style.color  = active ? 'rgba(255,255,255,0.7)'  : 'rgba(255,255,255,0.45)';
      card.querySelector('.donate-tier-desc').style.color  = active ? 'rgba(255,255,255,0.85)' : 'rgba(255,255,255,0.6)';
      card.querySelector('.donate-tier-desc').style.marginBottom = active ? '24px' : '0';
      var badge = card.querySelector('.donate-tier-badge');
      if (badge) badge.style.color = active ? 'rgba(255,255,255,0.85)' : 'var(--gold)';
      card.querySelector('.donate-tier-stepper').style.display = active ? 'flex' : 'none';
      card.querySelector('.donate-tier-qty').textContent = active ? donateQty : 1;
    });
  }

  function updateDonateTotal() {
    var total = donateTierValues[donateSelectedIdx] * donateQty;
    document.getElementById('donate-total-amount').textContent = '$' + total;
    document.getElementById('donate-impact-lines').textContent = donateQty + '× $' + donateTierValues[donateSelectedIdx];
  }

  function submitDonation() {
    console.log('[donate-en] submit triggered');

    var btn    = document.getElementById('donate-submit-btn');
    var status = document.getElementById('donate-status');
    var name   = document.getElementById('donate-name').value.trim();
    var email  = document.getElementById('donate-email').value.trim();
    var total  = donateTierValues[donateSelectedIdx] * donateQty;

    var payload = {
      name:     name,
      email:    email,
      pkg:      donateTierLabels[donateSelectedIdx] + ' ($' + donateTierValues[donateSelectedIdx] + ')',
      quantity: donateQty,
      total:    total,
    };
    console.log('[donate-en] payload:', payload);

    btn.disabled = true;
    btn.textContent = 'Sending…';
    btn.onmouseover = null;
    btn.onmouseout  = null;
    btn.style.background = '#b38630';
    status.style.display = 'none';

    fetch('/donate-request', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    })
    .then(function(res) {
      console.log('[donate-en] HTTP status:', res.status);
      return res.json();
    })
    .then(function(data) {
      console.log('[donate-en] server response:', data);
      if (data.ok) {
        btn.textContent = 'Donation Sent ✓';
        btn.style.background = '#2e7d32';
        btn.style.color = '#fff';
        status.style.display  = 'block';
        status.style.color    = 'rgba(255,255,255,0.65)';
        status.textContent    = 'Thank you! We\'ll be in touch soon.';
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    })
    .catch(function(err) {
      console.error('[donate-en] error:', err && err.message ? err.message : err);
      btn.disabled = false;
      btn.textContent = 'Donate Now';
      btn.style.background = '#C9973A';
      btn.style.color = 'var(--ink)';
      btn.onmouseover = function() { btn.style.background = '#E8C06A'; };
      btn.onmouseout  = function() { btn.style.background = '#C9973A'; };
      status.style.display = 'block';
      status.style.color   = '#ff8a80';
      status.textContent   = 'Something went wrong. Please try again.';
    });
  }
</script>
