<% if (topSpacer) { %><div class="h-[68px]"></div><% } %>

<section class="py-16 px-4 md:py-20 md:px-8 lg:py-[100px] lg:px-16" style="background:var(--accent);">
  <div class="max-w-[1100px] mx-auto">

    <div class="flex items-center mb-5" style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);">
      <span class="inline-block w-7 h-px mr-2.5" style="background:var(--gold);"></span>
      Підтримайте нас
    </div>

    <h1 class="mb-4" style="font-family:'Playfair Display',serif;font-size:clamp(36px,5vw,68px);font-weight:900;line-height:1.08;color:#fff;">Змініть чиєсь життя сьогодні</h1>
    <p class="mb-12 max-w-[520px]" style="font-size:17px;color:rgba(255,255,255,0.65);line-height:1.7;">
      Ваша щедрість живить кожну нашу програму. Кожен долар спрямовується безпосередньо громадам Мозамбіку.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-[2px] mb-[2px]">
      <% const uaDonateTiers = [
        { value:25,  label:'Прихильник', badge:null,             desc:'Забезпечує шкільним приладдям одну дитину на семестр.' },
        { value:100, label:'Чемпіон',    badge:'Найпопулярніше', desc:"Годує сім'ю з чотирьох осіб протягом місяця." },
        { value:500, label:'Лідер',      badge:null,             desc:'Фінансує річну програму наставництва для одного підлітка.' },
      ]; %>
      <% uaDonateTiers.forEach(function(t, i) { %>
        <div
          class="ua-donate-tier-card p-8 md:p-10 cursor-pointer transition-all duration-200"
          onclick="selectUaDonatePkg(<%= i %>)"
          style="background:<%= i===1 ? 'var(--gold)' : 'rgba(255,255,255,0.06)' %>;border-top:3px solid <%= i===1 ? 'transparent' : 'rgba(201,151,58,0.25)' %>;">
          <% if (t.badge) { %>
            <div class="ua-donate-tier-badge text-[10px] font-bold uppercase mb-2" style="letter-spacing:0.12em;color:<%= i===1 ? 'rgba(255,255,255,0.85)' : 'var(--gold)' %>;"><%= t.badge %></div>
          <% } %>
          <div class="ua-donate-tier-amount leading-none mb-2" style="font-family:'Playfair Display',serif;font-size:clamp(36px,4vw,48px);font-weight:900;color:#fff;">$<%= t.value %></div>
          <div class="ua-donate-tier-name text-[13px] font-semibold uppercase mb-3" style="letter-spacing:0.08em;color:<%= i===1 ? 'rgba(255,255,255,0.7)' : 'rgba(255,255,255,0.45)' %>;"><%= t.label %></div>
          <p class="ua-donate-tier-desc text-sm leading-relaxed" style="color:<%= i===1 ? 'rgba(255,255,255,0.85)' : 'rgba(255,255,255,0.6)' %>;margin-bottom:<%= i===1 ? '24px' : '0' %>;"><%= t.desc %></p>

          <div class="ua-donate-tier-stepper items-center justify-between pt-5" style="border-top:1px solid rgba(255,255,255,0.22);display:<%= i===1 ? 'flex' : 'none' %>;">
            <button
              onclick="adjustUaDonateQty(-1)"
              style="width:44px;height:44px;border:1px solid rgba(255,255,255,0.35);background:none;color:#fff;font-size:22px;line-height:1;cursor:pointer;border-radius:2px;display:flex;align-items:center;justify-content:center;font-family:'DM Sans',sans-serif;flex-shrink:0;transition:background 0.15s;"
              onmouseover="this.style.background='rgba(255,255,255,0.12)';"
              onmouseout="this.style.background='none';">−</button>
            <div style="min-width:52px;text-align:center;">
              <div class="ua-donate-tier-qty" style="font-family:'Playfair Display',serif;font-size:30px;font-weight:700;color:#fff;line-height:1;">1</div>
            </div>
            <button
              onclick="adjustUaDonateQty(1)"
              style="width:44px;height:44px;border:1px solid rgba(255,255,255,0.35);background:none;color:#fff;font-size:22px;line-height:1;cursor:pointer;border-radius:2px;display:flex;align-items:center;justify-content:center;font-family:'DM Sans',sans-serif;flex-shrink:0;transition:background 0.15s;"
              onmouseover="this.style.background='rgba(255,255,255,0.12)';"
              onmouseout="this.style.background='none';">+</button>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[2px] p-6 md:p-12" style="background:rgba(255,255,255,0.04);">

      <div class="md:pr-10 pb-8 md:pb-0">
        <h3 class="mb-7" style="font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#fff;">Пожертвувати</h3>

        <div class="mb-5">
          <label class="block text-xs font-semibold uppercase mb-2" style="letter-spacing:0.08em;color:rgba(255,255,255,0.5);">Як до вас звертатися? (необов'язково)</label>
          <input id="ua-donate-name" type="text" placeholder="Іван Іваненко"
            class="w-full rounded text-[15px] px-4 py-3 outline-none"
            style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:#fff;font-family:'DM Sans',sans-serif;" />
        </div>

        <div class="mb-7">
          <label class="block text-xs font-semibold uppercase mb-2" style="letter-spacing:0.08em;color:rgba(255,255,255,0.5);">Email (необов'язково)</label>
          <input id="ua-donate-email" type="email" placeholder="ivan@example.com"
            class="w-full rounded text-[15px] px-4 py-3 outline-none"
            style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:#fff;font-family:'DM Sans',sans-serif;" />
        </div>

        <button id="ua-donate-submit-btn" type="button"
          class="w-full rounded text-[15px] font-bold py-4 cursor-pointer border-0 transition-colors"
          style="background:var(--gold);color:var(--ink);font-family:'DM Sans',sans-serif;letter-spacing:0.04em;"
          onmouseover="this.style.background='#E8C06A';"
          onmouseout="this.style.background='#C9973A';"
          onclick="submitUaDonation()">
          Пожертвувати
        </button>
        <div id="ua-donate-status" style="display:none;margin-top:14px;font-size:14px;font-family:'DM Sans',sans-serif;"></div>
      </div>

      <div class="md:pl-10 pt-8 md:pt-0 flex flex-col justify-center" style="border-top:1px solid rgba(201,151,58,0.15);">
        <div class="text-[11px] font-semibold uppercase mb-3" style="letter-spacing:0.14em;color:rgba(255,255,255,0.4);">Ваша сума</div>
        <div id="ua-donate-total-amount" class="mb-3 leading-none" style="font-family:'Playfair Display',serif;font-size:48px;font-weight:900;color:var(--gold);">$100</div>
        <p id="ua-donate-impact-lines" class="text-[14px] leading-7 mb-8" style="color:rgba(255,255,255,0.5);">1× $100</p>
        <div class="text-xs leading-relaxed" style="color:rgba(255,255,255,0.35);">🔒 Безпечна, зашифрована оплата. Квитанція надається.</div>
      </div>

    </div>

  </div>
</section>

<script>
  var uaDonateTierValues  = [25, 100, 500];
  var uaDonateTierLabels  = ['Прихильник', 'Чемпіон', 'Лідер'];
  var uaDonateSelectedIdx = 1;
  var uaDonateQty         = 1;

  function selectUaDonatePkg(idx) {
    if (uaDonateSelectedIdx === idx) return;
    uaDonateSelectedIdx = idx;
    uaDonateQty = 1;
    renderUaDonateCards();
    updateUaDonateTotal();
  }

  function adjustUaDonateQty(delta) {
    uaDonateQty = Math.max(1, uaDonateQty + delta);
    var cards = document.querySelectorAll('.ua-donate-tier-card');
    cards[uaDonateSelectedIdx].querySelector('.ua-donate-tier-qty').textContent = uaDonateQty;
    updateUaDonateTotal();
  }

  function renderUaDonateCards() {
    document.querySelectorAll('.ua-donate-tier-card').forEach(function(card, i) {
      var active = i === uaDonateSelectedIdx;
      card.style.background     = active ? 'var(--gold)' : 'rgba(255,255,255,0.06)';
      card.style.borderTopColor = active ? 'transparent' : 'rgba(201,151,58,0.25)';
      card.querySelector('.ua-donate-tier-name').style.color  = active ? 'rgba(255,255,255,0.7)'  : 'rgba(255,255,255,0.45)';
      card.querySelector('.ua-donate-tier-desc').style.color  = active ? 'rgba(255,255,255,0.85)' : 'rgba(255,255,255,0.6)';
      card.querySelector('.ua-donate-tier-desc').style.marginBottom = active ? '24px' : '0';
      var badge = card.querySelector('.ua-donate-tier-badge');
      if (badge) badge.style.color = active ? 'rgba(255,255,255,0.85)' : 'var(--gold)';
      card.querySelector('.ua-donate-tier-stepper').style.display = active ? 'flex' : 'none';
      card.querySelector('.ua-donate-tier-qty').textContent = active ? uaDonateQty : 1;
    });
  }

  function updateUaDonateTotal() {
    var total = uaDonateTierValues[uaDonateSelectedIdx] * uaDonateQty;
    document.getElementById('ua-donate-total-amount').textContent = '$' + total;
    document.getElementById('ua-donate-impact-lines').textContent = uaDonateQty + '× $' + uaDonateTierValues[uaDonateSelectedIdx];
  }

  function submitUaDonation() {
    console.log('[donate-ua] submit triggered');

    var btn    = document.getElementById('ua-donate-submit-btn');
    var status = document.getElementById('ua-donate-status');
    var name   = document.getElementById('ua-donate-name').value.trim();
    var email  = document.getElementById('ua-donate-email').value.trim();
    var total  = uaDonateTierValues[uaDonateSelectedIdx] * uaDonateQty;

    var payload = {
      name:     name,
      email:    email,
      pkg:      uaDonateTierLabels[uaDonateSelectedIdx] + ' ($' + uaDonateTierValues[uaDonateSelectedIdx] + ')',
      quantity: uaDonateQty,
      total:    total,
    };
    console.log('[donate-ua] payload:', payload);

    btn.disabled = true;
    btn.textContent = 'Надсилання…';
    btn.onmouseover = null;
    btn.onmouseout  = null;
    btn.style.background = '#b38630';
    status.style.display = 'none';

    fetch('/donate-request', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    })
    .then(function(res) {
      console.log('[donate-ua] HTTP status:', res.status);
      return res.json();
    })
    .then(function(data) {
      console.log('[donate-ua] server response:', data);
      if (data.ok) {
        btn.textContent = 'Надіслано ✓';
        btn.style.background = '#2e7d32';
        btn.style.color = '#fff';
        status.style.display  = 'block';
        status.style.color    = 'rgba(255,255,255,0.65)';
        status.textContent    = 'Дякуємо! Ми зв\'яжемося з вами найближчим часом.';
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    })
    .catch(function(err) {
      console.error('[donate-ua] error:', err && err.message ? err.message : err);
      btn.disabled = false;
      btn.textContent = 'Пожертвувати';
      btn.style.background = '#C9973A';
      btn.style.color = 'var(--ink)';
      btn.onmouseover = function() { btn.style.background = '#E8C06A'; };
      btn.onmouseout  = function() { btn.style.background = '#C9973A'; };
      status.style.display = 'block';
      status.style.color   = '#ff8a80';
      status.textContent   = 'Сталася помилка. Спробуйте ще раз.';
    });
  }
</script>
