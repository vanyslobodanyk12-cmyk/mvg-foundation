<section style="background:#FDFAF5;padding:120px 64px 100px;">
  <div style="max-width:1200px;margin:0 auto;">

    <div style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;margin-bottom:20px;">
      <span style="display:inline-block;width:28px;height:1px;background:var(--gold);margin-right:10px;"></span>
      What We Do
    </div>

    <h1 style="font-family:'Playfair Display',serif;font-size:clamp(38px,5vw,68px);font-weight:900;line-height:1.08;color:var(--ink);margin-bottom:16px;">Programs that transform lives</h1>
    <p style="font-size:17px;color:var(--muted);line-height:1.75;max-width:600px;margin-bottom:64px;">
      Year-round initiatives designed to address the most pressing needs. Each program is built on evidence-based practices, community input, and measurable outcomes.
    </p>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;">
      <% const programs = [
        { icon:'📚', title:'Education & Tutoring',  body:'Free after-school tutoring, college prep workshops, and scholarship opportunities for students from low-income households.' },
        { icon:'🌾', title:'Food Security',          body:'Weekly food distributions, community gardens, and partnerships with local food banks to ensure no family goes hungry.' },
        { icon:'🏥', title:'Health & Wellness',      body:'Free health screenings, mental health resources, and referrals to affordable care for uninsured community members.' },
        { icon:'💼', title:'Job Readiness',          body:'Resume workshops, interview coaching, and connections to local employers for adults seeking stable employment.' },
        { icon:'🌱', title:'Youth Leadership',       body:'Mentorship programs, civic engagement training, and leadership retreats to develop the next generation of community advocates.' },
        { icon:'🤝', title:'Senior Support',         body:'Transportation assistance, meal delivery, and social activities for elderly residents who may be isolated or underserved.' },
      ]; %>
      <% programs.forEach(p => { %>
        <div style="background:var(--cream);padding:48px 40px;border-top:3px solid var(--gold);">
          <div style="font-size:28px;margin-bottom:20px;width:56px;height:56px;display:flex;align-items:center;justify-content:center;background:var(--accent);border-radius:2px;">
            <%= p.icon %>
          </div>
          <h3 style="font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--ink);margin-bottom:14px;line-height:1.3;"><%= p.title %></h3>
          <p style="font-size:15px;line-height:1.75;color:var(--muted);"><%= p.body %></p>
        </div>
      <% }) %>
    </div>

  </div>
</section>
