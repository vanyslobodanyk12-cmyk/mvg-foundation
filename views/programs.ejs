<section class="pt-[88px] pb-12 px-4 md:pt-[100px] md:pb-16 md:px-8 lg:pt-[120px] lg:pb-[100px] lg:px-16" style="background:#FDFAF5;">
  <div class="max-w-[1200px] mx-auto">

    <div class="flex items-center mb-5" style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);">
      <span class="inline-block w-7 h-px mr-2.5" style="background:var(--gold);"></span>
      What We Do
    </div>

    <h1 class="mb-4" style="font-family:'Playfair Display',serif;font-size:clamp(36px,5vw,68px);font-weight:900;line-height:1.08;color:var(--ink);">Programs that transform lives</h1>
    <p class="mb-12 lg:mb-16 max-w-[600px]" style="font-size:17px;color:var(--muted);line-height:1.75;">
      Year-round initiatives designed to address the most pressing needs. Each program is built on evidence-based practices, community input, and measurable outcomes.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[2px]">
      <% const programs = [
        { icon:'<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',                                                     title:'Education & Tutoring',  body:'Free after-school tutoring, college prep workshops, and scholarship opportunities for students from low-income households.' },
        { icon:'<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',        title:'Food Security',          body:'Weekly food distributions, community gardens, and partnerships with local food banks to ensure no family goes hungry.' },
        { icon:'<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',                                                                                                               title:'Health & Wellness',      body:'Free health screenings, mental health resources, and referrals to affordable care for uninsured community members.' },
        { icon:'<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',                                                   title:'Job Readiness',          body:'Resume workshops, interview coaching, and connections to local employers for adults seeking stable employment.' },
        { icon:'<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',                                                                             title:'Youth Leadership',       body:'Mentorship programs, civic engagement training, and leadership retreats to develop the next generation of community advocates.' },
        { icon:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',  title:'Senior Support',         body:'Transportation assistance, meal delivery, and social activities for elderly residents who may be isolated or underserved.' },
      ]; %>
      <% programs.forEach(p => { %>
        <div class="p-8 md:p-10 lg:p-12" style="background:var(--cream);border-top:3px solid var(--gold);">
          <div class="mb-6">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><%- p.icon %></svg>
          </div>
          <h3 class="mb-3 leading-snug" style="font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--ink);"><%= p.title %></h3>
          <p class="text-[15px] leading-7" style="color:var(--muted);"><%= p.body %></p>
        </div>
      <% }) %>
    </div>

  </div>
</section>
