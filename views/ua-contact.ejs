<section class="pt-[88px] pb-12 px-4 md:pt-[100px] md:pb-16 md:px-8 lg:pt-[120px] lg:pb-[100px] lg:px-16" style="background:#FDFAF5;">
  <div class="max-w-[1100px] mx-auto">

    <div class="flex items-center mb-5" style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);">
      <span class="inline-block w-7 h-px mr-2.5" style="background:var(--gold);"></span>
      Зв'яжіться з нами
    </div>

    <h1 class="mb-4" style="font-family:'Playfair Display',serif;font-size:clamp(36px,5vw,68px);font-weight:900;line-height:1.08;color:var(--ink);">Контакти</h1>
    <p class="mb-12 lg:mb-16 max-w-[520px]" style="font-size:17px;color:var(--muted);line-height:1.75;">
      Маєте питання, хочете стати волонтером або партнером? Ми будемо раді почути вас.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-[2px]">

      <div class="lg:col-span-3 p-8 md:p-12" style="background:var(--cream);">
        <% [["Ім'я","Ваше ім'я",'text'],['Електронна пошта','ваш@email.com','email'],['Тема','Чим можемо допомогти?','text']].forEach(([label,ph,type]) => { %>
          <div class="mb-5">
            <label class="block text-xs font-semibold uppercase mb-2" style="letter-spacing:0.08em;color:var(--muted);"><%= label %></label>
            <input type="<%= type %>" placeholder="<%= ph %>"
              class="w-full rounded text-[15px] px-4 py-3 outline-none"
              style="background:#fff;border:1px solid rgba(0,0,0,0.12);color:var(--ink);font-family:'DM Sans',sans-serif;" />
          </div>
        <% }) %>
        <div class="mb-7">
          <label class="block text-xs font-semibold uppercase mb-2" style="letter-spacing:0.08em;color:var(--muted);">Повідомлення</label>
          <textarea rows="5"
            class="w-full rounded text-[15px] px-4 py-3 outline-none resize-y"
            style="background:#fff;border:1px solid rgba(0,0,0,0.12);color:var(--ink);font-family:'DM Sans',sans-serif;"></textarea>
        </div>
        <button type="button"
          class="text-[15px] font-semibold px-9 py-4 rounded cursor-pointer border-0 transition-colors"
          style="background:var(--accent);color:#fff;font-family:'DM Sans',sans-serif;letter-spacing:0.04em;"
          onmouseover="this.style.background='#2a5a3e';"
          onmouseout="this.style.background='var(--accent)';">
          Надіслати
        </button>
      </div>

      <div class="lg:col-span-2 flex flex-col gap-[2px]">
        <% const info = [
          { label:'Адреса',           value:'123 Community Drive, Suite 400\nМапуту, Мозамбік' },
          { label:'Електронна пошта', value:'info@mvgfoundation.org' },
          { label:'Телефон',          value:'+258 21 123 456' },
          { label:'Години роботи',    value:'Пн–Пт: 9:00 – 17:00\nСб: 10:00 – 14:00' },
        ]; %>
        <% info.forEach((item, i) => { %>
          <div class="px-8 py-7 flex-1" style="background:<%= i % 2 === 0 ? 'var(--cream)' : 'rgba(201,151,58,0.06)' %>;border-left:2px solid var(--gold);">
            <div class="text-[11px] font-semibold uppercase mb-2" style="letter-spacing:0.12em;color:var(--gold);"><%= item.label %></div>
            <div class="text-[15px] leading-relaxed" style="color:var(--ink);white-space:pre-line;"><%= item.value %></div>
          </div>
        <% }) %>
      </div>

    </div>
  </div>
</section>
